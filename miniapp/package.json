{
  "name": "kferp-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:environment": "node scripts/assert-build-environment.mjs",
    "dev:mp-weixin": "npm run check:environment && uni -p mp-weixin",
    "dev:mp-weixin:development": "VITE_KFERP_ENVIRONMENT=development VITE_KFERP_API_BASE=https://dev.qacoohee.com/app npm run dev:mp-weixin",
    "build:mp-weixin": "npm run check:environment && uni build -p mp-weixin",
    "build:mp-weixin:development": "VITE_KFERP_ENVIRONMENT=development VITE_KFERP_API_BASE=https://dev.qacoohee.com/app npm run build:mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5000720260410001",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vite": "5.2.8",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
