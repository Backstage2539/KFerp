{
  auto_https disable_redirects
}

erp.qacoohee.com:443 {
  encode zstd gzip

  handle_path /import/* {
    root * /srv/import
    file_server
  }

  handle_path /app/* {
    reverse_proxy erp_prod_orderapp:8080
  }

  handle {
    reverse_proxy erp_prod_orderapp:8080
  }
}

dev.qacoohee.com:443 {
  encode zstd gzip

  handle_path /import/* {
    root * /srv/import
    file_server
  }

  handle_path /app/* {
    reverse_proxy erp_orderapp:8080
  }

  handle {
    reverse_proxy erp_orderapp:8080
  }
}
